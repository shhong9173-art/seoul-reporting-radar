{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "seoul-reporting-radar",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "STORE",
        "class_name": "RadarStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RadarStore"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/10 21-23 * * *",
      "*/10 6-9 * * *"
    ]
  },
  "ai": {
    "binding": "AI"
  }
}
